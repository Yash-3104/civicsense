# Spring profile: use dev locally, prod for deployed backend.
SPRING_PROFILES_ACTIVE=dev

# Backend HTTP port.
SERVER_PORT=8031
SERVER_ADDRESS=0.0.0.0

# Local DB host used by the dev DB_URL default.
DB_HOST=localhost

# Local DB port used by the dev DB_URL default.
DB_PORT=5432

# Local DB name used by the dev DB_URL default.
DB_NAME=civicsense_db

# Production JDBC URL. Required when SPRING_PROFILES_ACTIVE=prod.
DB_URL=jdbc:postgresql://localhost:5432/civicsense_db

# Database username. Required in prod.
DB_USER=civicsense_user

# Database password. Required in prod.
DB_PASSWORD=replace-with-local-db-password

# JWT signing secret. Required in prod; use a long random secret.
JWT_SECRET=replace-with-long-random-jwt-secret

# JWT expiration in milliseconds.
JWT_EXPIRATION=604800000

# JPA SQL logging toggle for dev diagnostics.
JPA_SHOW_SQL=false

# JPA formatted SQL toggle for dev diagnostics.
JPA_FORMAT_SQL=false

# Hibernate schema mode; keep none for prod.
JPA_DDL_AUTO=none

# Flyway migrations. Leave false locally unless intentionally testing migrations; prod defaults to true.
FLYWAY_ENABLED=false
FLYWAY_LOCATIONS=filesystem:../../database/migrations

# Public backend origin used when building local upload URLs.
PUBLIC_BASE_URL=http://localhost:8031

# Comma-separated allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI service base URL, not an endpoint path.
AI_SERVICE_BASE_URL=http://localhost:8000

# Local upload directory.
FILE_UPLOAD_DIR=uploads

# Storage provider. Use local for dev, cloudinary for hosted image storage.
STORAGE_PROVIDER=local

# Whether /uploads/** is publicly readable for local upload storage.
UPLOADS_PUBLIC=true

# Cloudinary storage settings. Required only when STORAGE_PROVIDER=cloudinary.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
CLOUDINARY_FOLDER=civicsense

# Multipart upload limits.
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=25MB
